        "jsCode": "const source = $node['Loop Over Sources'].json;\nconst clientString = source.client_label ? ` | Client: ${source.client_label}` : '';\nreturn { json: { message: `🛡️ *SigOne — Daily Brief*\\n📅 ${new Date().toISOString().split('T')[0]} | Source: ${source.source_id}${clientString}\\n\\nNo security events recorded in the last 24 hours.`, source: source, stats: { total_events: 0 } } };"
      },
