      "id": "postgres-get-sources",
      "name": "Get Active Sources",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [200, 0],
      "credentials": {
        "postgres": {
          "id": "sigone-postgres",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "loop-sources",
      "name": "Loop Over Sources",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [400, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  (SELECT COUNT(*) FROM security_events WHERE source_id = $1 AND received_at >= NOW() - INTERVAL '1 day') as total_events,\n  (SELECT COUNT(*) FROM security_events WHERE source_id = $1 AND received_at >= NOW() - INTERVAL '1 day' AND severity = 'critical') as critical_events,\n  (SELECT COUNT(*) FROM security_events WHERE source_id = $1 AND received_at >= NOW() - INTERVAL '1 day' AND severity = 'high') as high_events,\n  (SELECT COUNT(*) FROM security_events WHERE source_id = $1 AND received_at >= NOW() - INTERVAL '1 day' AND severity = 'medium') as medium_events,\n  (SELECT COUNT(*) FROM security_events WHERE source_id = $1 AND received_at >= NOW() - INTERVAL '1 day' AND severity = 'low') as low_events,\n  (SELECT rule_name FROM security_events WHERE source_id = $1 AND received_at >= NOW() - INTERVAL '1 day' GROUP BY rule_name ORDER BY COUNT(*) DESC LIMIT 1) as top_rule,\n  (SELECT src_ip FROM security_events WHERE source_id = $1 AND received_at >= NOW() - INTERVAL '1 day' AND src_ip IS NOT NULL GROUP BY src_ip ORDER BY COUNT(*) DESC LIMIT 1) as top_ip;\n",
        "options": {
          "queryParameters": "={{ $json.source_id }}"
        }
      },
      "id": "postgres-get-stats",
      "name": "Get Daily Stats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [600, 0],
      "credentials": {
        "postgres": {
          "id": "sigone-postgres",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT severity, rule_name, description, src_ip, dst_ip, hostname, mitre_technique, mitre_tactic \nFROM security_events \nWHERE source_id = $1 AND received_at >= NOW() - INTERVAL '1 day' \nORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 WHEN 'low' THEN 4 ELSE 5 END, received_at DESC \nLIMIT 50;",
        "options": {
          "queryParameters": "={{ $node['Loop Over Sources'].json.source_id }}"
        }
      },
      "id": "postgres-get-events",
      "name": "Get Today's Events (Capped)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [800, 0],
      "credentials": {
        "postgres": {
          "id": "sigone-postgres",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $node['Get Daily Stats'].json.total_events > 0 }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-events-exist",
      "name": "Any events today?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const events = $items('Get Today\\'s Events (Capped)').map(i => i.json);\n\n// Collect all external IPs (src_ip + dst_ip), filter out internal/null\nconst isInternal = (ip) => {\n  if (!ip) return true;\n  return ip.startsWith('10.') || ip.startsWith('192.168.') || ip.startsWith('172.16.') || ip.startsWith('172.17.') || ip.startsWith('172.18.') || ip.startsWith('172.19.') || ip.startsWith('172.20.') || ip.startsWith('172.21.') || ip.startsWith('172.22.') || ip.startsWith('172.23.') || ip.startsWith('172.24.') || ip.startsWith('172.25.') || ip.startsWith('172.26.') || ip.startsWith('172.27.') || ip.startsWith('172.28.') || ip.startsWith('172.29.') || ip.startsWith('172.30.') || ip.startsWith('172.31.') || ip === '127.0.0.1' || ip === '::1';\n};\n\nconst ipCounts = {};\nevents.forEach(e => {\n  [e.src_ip, e.dst_ip].forEach(ip => {\n    if (ip && !isInternal(ip)) {\n      ipCounts[ip] = (ipCounts[ip] || 0) + 1;\n    }\n  });\n});\n\n// Sort by frequency, take top 3\nconst topIPs = Object.entries(ipCounts)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 3)\n  .map(([ip, count]) => ({ ip, count }));\n\nreturn topIPs.length > 0\n  ? topIPs.map(item => ({ json: item }))\n  : [{ json: { ip: null, count: 0 } }];"
      },
      "id": "code-extract-ips",
      "name": "Extract Top IPs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, -100]
    },
    {
      "parameters": {
        "options": {
          "batchSize": 1
        }
      },
      "id": "loop-ips",
      "name": "Loop IPs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1400, -100]
    },
    {
      "parameters": {
        "conditions": {
