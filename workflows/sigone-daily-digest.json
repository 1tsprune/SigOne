    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO threat_intel_cache (indicator, indicator_type, vt_malicious, vt_total, vt_link, last_checked_at) VALUES ($1, 'ip', $2, $3, $4, NOW()) ON CONFLICT (indicator) DO UPDATE SET vt_malicious = $2, vt_total = $3, vt_link = $4, last_checked_at = NOW();",
        "options": {
          "queryParameters": "={{ $node['Loop IPs'].json.ip }}, {{ $json.data.attributes.last_analysis_stats.malicious || 0 }}, {{ ($json.data.attributes.last_analysis_stats.malicious || 0) + ($json.data.attributes.last_analysis_stats.undetected || 0) + ($json.data.attributes.last_analysis_stats.harmless || 0) }}, https://www.virustotal.com/gui/ip-address/{{ $node['Loop IPs'].json.ip }}"
        }
      },
      "id": "postgres-save-cache",
      "name": "Save to Cache",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [2600, -100],
      "credentials": {
        "postgres": {
          "id": "sigone-postgres",
