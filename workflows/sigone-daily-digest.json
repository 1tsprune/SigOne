    {
      "parameters": {},
      "id": "noop-vt-done",
      "name": "VT IP Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2800, -200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT indicator, vt_malicious, vt_total, vt_link FROM threat_intel_cache WHERE indicator = ANY(string_to_array($1, ',')) AND last_checked_at > NOW() - INTERVAL '7 days';",
        "options": {
          "queryParameters": "={{ $items('Extract Top IPs').map(i => i.json.ip).filter(ip => ip !== null).join(',') }}"
        }
      },
      "id": "postgres-get-vt-results",
      "name": "Get VT Results",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [3000, -100],
      "credentials": {
        "postgres": {
          "id": "sigone-postgres",
          "name": "Postgres account"
        }
      }
