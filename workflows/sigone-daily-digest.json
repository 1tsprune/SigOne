        "query": "SELECT * FROM threat_intel_cache WHERE indicator = $1 AND last_checked_at > NOW() - INTERVAL '7 days';",
        "options": {
          "queryParameters": "={{ $json.ip }}"
        }
      },
      "id": "postgres-check-cache",
      "name": "Check VT Cache",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [1800, -200],
      "credentials": {
        "postgres": {
          "id": "sigone-postgres",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
